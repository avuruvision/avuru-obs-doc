{
  "name": "avuru-obs-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for avuru obs \u2014 APM & observability without friction.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:fr": "docusaurus start --locale fr",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint:docs": "node scripts/lint-frontmatter.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:browser": "playwright test",
    "test:examples": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "audit:i18n": "node scripts/audit-i18n.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0"
  }
}
